# Absolute path to an Obsidian-style Vault.
# When omitted, the app uses ../个人知识库.
PERSONAL_DASHBOARD_VAULT_ROOT=/absolute/path/to/your-vault

# Optional. External Obsidian vault root for the 求职备战 (career) page.
# The career page reads a small allow-list under this root (职业规划/题库, 概念,
# 面试研究地图, 求职2026) and never writes back. Omit to leave the page empty.
# CAREER_VAULT_ROOT=/absolute/path/to/your-obsidian-vault

# Optional. External Obsidian vault root for the 知识星图 (/graph) and Wiki 层
# (/wiki) pages. When set, these two pages read the knowledge body of this vault
# (股票/职业规划/AI方法论/Resources 白名单) instead of the demo 个人知识库.
# Falls back to CAREER_VAULT_ROOT when OBSIDIAN_VAULT_ROOT is unset.
# OBSIDIAN_VAULT_ROOT=/absolute/path/to/your-obsidian-vault

# Optional. Keep the development server loopback-only unless you add auth.
# PERSONAL_DASHBOARD_HOST=127.0.0.1
